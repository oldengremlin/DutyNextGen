<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>net.ukrhub</groupId>
    <artifactId>duty-nextgen</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Duty NextGen</name>
    <description>Планування чергувань системних адміністраторів — веб-редагування графіка, CalDAV-синхронізація, автоматична генерація наступного місяця. Наступне покоління проєкту Duty (заміна Perl CGI + CVS).</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>duty-nextgen</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- GitCommitService передає кириличні автора/повідомлення дочірньому
                         процесу git через sun.jnu.encoding — це native-кодування JVM,
                         фіксоване на старті процесу за LANG/LC_ALL. Без цього форкований
                         тестовий JVM у середовищі без UTF-8-локалі (типово для мінімальних
                         CI-контейнерів) успадковує ASCII-кодування, і кирилиця
                         пошкоджується ще до того, як дійде до git. -->
                    <environmentVariables>
                        <LANG>C.UTF-8</LANG>
                        <LC_ALL>C.UTF-8</LC_ALL>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
