#!/bin/sh
#
# Збірка й запуск duty-nextgen у Docker. За аналогією з dbuild
# кореневого (застарілого) проєкту. data/config — зовнішні томи,
# в образ не запікаються.

docker network create events-network 2>/dev/null

docker stop duty-nextgen
docker container rm duty-nextgen
docker container prune -f

export DOCKER_BUILDKIT=0; docker build --network events-network -t oldengremlin/duty-nextgen:latest .

docker run -d \
    --network events-network \
    -v /safe/duty-nextgen/data:/data \
    -v /safe/duty-nextgen/config:/config \
    -p 8080:8080 \
    --name duty-nextgen \
    oldengremlin/duty-nextgen:latest

# CalDAV-синхронізація (Baikal) — вимкнена, доки не задано. Найпростіше:
# покласти /safe/duty-nextgen/config/duty-caldav.conf (той самий формат
# CALDAV_BASE_URL/CALDAV_USER/CALDAV_PASS, яким користувався застарілий
# duty-caldav-sync, і те саме "поза CVS/git" розташування) — застосунок
# сам його прочитає з уже змонтованого /config, без жодних змін у
# docker run. Змінні середовища DUTY_CALDAV_BASE_URL/_USER/_PASSWORD —
# альтернатива (мають пріоритет над файлом, якщо задані обидва):
#
# docker run -d ... \
#     -e DUTY_CALDAV_BASE_URL="https://www.ukr-com.net:7580/dav.php/calendars/NOC/CALENDAR" \
#     -e DUTY_CALDAV_USER="..." \
#     -e DUTY_CALDAV_PASSWORD="..." \
#     ...

docker update --restart unless-stopped duty-nextgen

# Первинна ініціалізація (один раз, після першого запуску) —
# створити першого користувача веб-автентифікації:
# docker exec -it duty-nextgen java -jar /app/app.jar add-user noc
